{
  "name": "tree-sitter-kizu",
  "version": "0.1.0",
  "description": "Kizu grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": ["incremental", "parsing", "tree-sitter", "kizu"],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^8.1.0",
    "node-gyp-build": "^4.8.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.25.0"
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "tree-sitter test",
    "generate": "tree-sitter generate"
  },
  "tree-sitter": [
    {
      "file-types": ["kizu"],
      "scope": "source.kizu",
      "injection-regex": "^kizu$"
    }
  ]
}
